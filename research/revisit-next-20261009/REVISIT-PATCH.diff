+    assert len(result['steps']) >= 2 and not scope.pending and scope.maximum_pending == 1
+    transform = CameraTransform([[.1, 0], [0, .1]], (.1, .1), True)
+    profile = save_objective_profile(scope, {'context': {'sample_id': 'g90'},
